# NetPlanner environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env` (SEC-12).

# Anthropic API key — required by the AI layer (Phase 2+). Keep it secret.
ANTHROPIC_API_KEY=

# Async SQLite database URL. The .db file lives in backend/data/ (gitignored).
DATABASE_URL=sqlite+aiosqlite:///./data/netplanner.db

# Runtime environment: development | staging | production.
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (frontend dev server default).
CORS_ORIGINS=http://localhost:5173

# --- Authentication (SEC-01 / SEC-14) -----------------------------------
# JWT signing secret for the session cookie. REQUIRED in production. Generate
# a long random value (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
JWT_SECRET=

# Session cookie attributes. Secure=true is required when the deployment is
# served over HTTPS (production default); flip to false for local plain HTTP.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=netplanner_session
SESSION_MAX_AGE_SECONDS=28800

# --- Transport hardening -----------------------------------------------
# Only enable HSTS when the deployment is HTTPS-terminated. Leaving it off in
# local dev avoids pinning your browser to HTTPS for the local origin.
ENABLE_HSTS=false
